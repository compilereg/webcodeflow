# Local `npm start` on http://localhost:3000:
# leave these empty so fetch/WS stay on localhost (cookie auth works).
# Vite proxies /api and /ws to VITE_PROXY_TARGET.
VITE_API_URL=
VITE_WS_URL=

# Live backend the proxy forwards to (dev only).
VITE_PROXY_TARGET=localhost:8888

# Production build: leave VITE_API_URL / VITE_WS_URL empty (same-origin).
#
# WebSocket path is fetched from backend via GET /api/main/getwspath.
# The backend's pc2v9.ini `wwfWSPath` setting is the source of truth.
# VITE_WS_URL is now an optional override for debugging or emergencies.
#
# Note: During local dev, the Vite proxy only forwards paths starting with /ws,
# so the backend's wwfWSPath must start with /ws/... (e.g., /ws/contest).
